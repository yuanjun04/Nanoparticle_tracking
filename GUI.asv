% --- Executes on button press in save_capture_button.
function save_capture_button_Callback(hObject, eventdata, handles)
% hObject    handle to save_capture_button (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)


% --- Executes on button press in capture_button.
function capture_button_Callback(hObject, eventdata, handles)
% hObject    handle to capture_button (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%stop any live preview
if str2double(get(handles.livetime,'string'))
    set(handles.livetime,'string','0');
    pause(0.5);
end

%get path to save to
savepath = get(handles.savepath,'string');
if strcmp(savepath,'Enter save path here')
    errordlg('Please choose where to capture this video to using the box on the left','Cannot Start Capture');
    return
end

%try and enforce some naming convention....
try
    str2doublr(savepath(end-5));
catch
    savepath = strcat(savepath(1:end-4),'0','.avi');
end

a = 0;
b = 0;
while a == 0
    try
        imread(strcat(savepath(1:end-5),num2str(b+1),'.avi'));
    catch
        savepath = strcat(savepath(1:end-5),num2str(b),'.avi');
        a = 1;
    end
    b = b + 1;
end

%read framerate into number.
framerate_string = get(handles.framerate_menu,'string');
framerate_value = get(handles.framerate_menu,'value');
if framerate_value == 0
    errordlg('Please choose a framerate and try again','Error! Framerate not set');
    return
end
framerate = string2framerate(framerate_string,framerate_value);

%read capture duration into number
capture_string = get(handles.capture_duration,'string');
capture_value = get(handles.capture_duration,'value');
if capture_value == 0
    errordlg('Please choose a duration and try again','Error! Duration not set');
    return
end
duration = string2duration(capture_string,capture_value);

%and then work out how many frames need to be captured
frames = round(duration * framerate);

%get other capture data
gainboost = get(handles.gainboost,'value');
gain = get(handles.gain_slider,'value');


exposure_val = exposures();
old_exposure = get(handles.exposure,'value');
exposure = old_exposure;
if and(old_exposure > exposure_val(1), old_exposure < exposure_val(2))
    %set(handles.exposure,'Min',exposure_val(1));
    %set(handles.exposure,'Max',exposure_val(2));
    %set(handles.exposure,'SliderStep',[exposure_val(3) exposure_val(3)]);
else
    %set(handles.exposure,'Value',exposure_val(1));
    %set(handles.exposure,'Min',exposure_val(1));
    %set(handles.exposure,'Max',exposure_val(2));
    %set(handles.exposure,'SliderStep',[exposure_val(3) exposure_val(3)]);
    exposure = exposure_val(2);
end
%exposure = get(handles.exposure,'value');

%disable capture botton to prevent duplicate mex function calls
%set(handles.capture_button,'Enable','off');

%AOI settings
if get(handles.limit_roi_checkbox,'value') == 1
    if strcmp('Left',get(handles.left_roi_limit,'string'))
        return
    else
        leftaoi = round(str2double(get(handles.left_roi_limit,'string')));
    end
    if strcmp('Right',get(handles.right_roi_limit,'string'))
        return
    else
        rightaoi = round(str2double(get(handles.right_roi_limit,'string')));
    end
    if strcmp('Top',get(handles.top_roi_limit,'string'))
        return
    else
        topaoi = round(str2double(get(handles.top_roi_limit,'string')));
    end
    if strcmp('Bottom',get(handles.bottom_roi_limit,'string'))
        return
    else
        bottomaoi = round(str2double(get(handles.bottom_roi_limit,'string')));
    end
    xstart = leftaoi;
    ystart = topaoi;
    width = abs(leftaoi-rightaoi);
    height = abs(topaoi-bottomaoi);
    %and validate the values to ensure they're compatible with the camera
    valid = validate_aoi(xstart,ystart,width,height);
    xstart = valid{1};
    ystart = valid{2};
    width = valid{3};
    height = valid{4};
    
else
    xstart = 1;
    ystart = 1;
    width = 0;
    height = 0;
end

%select the colour settings
grayscale = get(handles.mono_button,'value');

if ~get(handles.ssd,'value')
    %send the capture command
    nCap = ueye_capture_video(gainboost,gain,framerate,frames,exposure,savepath,xstart,ystart,width,height,grayscale);
else
    nCap = ueye_capture_video_SSD(gainboost,gain,framerate,frames,exposure,savepath,xstart,ystart,width,height,grayscale);
    
end
if nCap ~=0;
    errordlg('There was an error capturing your video. Check your settings and try again','Capture Error');
    set(handles.capture_button,'Enable','on');
    return
end

%re-enable capture button
set(handles.capture_button,'Enable','on');

%update handles structure
guidata(hObject,handles)









%convert the video once captured into a string of .tif files
% vid_path = get(handles.savepath,'string');
% set(handles.pathbox,'string',vid_path);
% avitif(vid_path)

% --- Executes on button press in process_button.
function process_button_Callback(hObject, ~, handles)
% hObject    handle to process_button (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%set button off to prevent multiple queueing or execution.
set(handles.process_button,'enable','off')
set(handles.popout_anal,'visible','off');



%choose what file to analyse
if get(handles.use_last_captured_button,'value') == 0
    vid_path = get(handles.pathbox,'string');
else
    vid_path = get(handles.savepath,'string');
    set(handles.pathbox,'string',vid_path);
end

%set minimum steps counter in the output to be the same as the processing
set(handles.minsteps2,'string',get(handles.minsteps_box,'string'));

%pull values for image pre-processing from the sliders
img_switches = zeros(3,1);
img_switches(1) = get(handles.denoise_box,'value');
img_switches(2) = get(handles.disc,'value');
img_switches(3) = get(handles.blur_box,'value');

img_params = zeros(3,1);
img_params(1) = get(handles.background,'value');
img_params(2) = get(handles.background_disk,'value');
img_params(3) = get(handles.blur,'value');

%define water viscosity table for allowed temperature range
viscwater = [0,0.0079;
    1,0.00173;
    2,0.00167;
    3,0.00162;
    4,0.00157;
    5,0.00152;
    6,0.00147;
    7,0.00143;
    8,0.00138;
    9,0.00134;
    10,0.00131;
    11,0.00127;
    12,0.00123;
    13,0.0012;
    14,0.00117;
    15,0.00114;
    16,0.00111;
    17,0.00108;
    18,0.00105;
    19,0.00103;
    20,0.001;
    21,0.000978;
    22,0.000954;
    23,0.000932;
    24,0.000911;
    25,0.00089;
    26,0.00087;
    27,0.000851;
    28,0.000832;
    29,0.000815;
    30,0.000797];

%get the viscosity
if get(handles.water,'value') == 1
    if str2double(get(handles.water_temp,'string')) == 0
        viscosity = 0.001; %assume 293K if unspecified
        temp = 293;
    elseif str2double(get(handles.water_temp,'string')) >303 %warn of temperature over 30 celsius
        errordlg('This is too high a temperature to reliably measure on this equipment. It will not produce accurate results!','Too hot!')
        viscosity = 0.000797; %default to value for 30 celsius
        temp = 303;
    elseif str2double(get(handles.water_temp,'string')) < 273
        tempq = questdlg('This temperature makes no physical sense for water. Did you give this temperature in Celsius by mistake?','Conversion error');
        if strcmp(tempq,'Yes')
            temp = str2double(get(handles.water_temp,'string')) + 273;
            viscosity = viscwater(temp-272,2);
            set(handles.water_temp,'string',num2str(temp));
        elseif strcmp(tempq,'No')
            errordlg('The viscosity lookup has no thundvalues in this range for the viscosity of water. They will assume you have water at 273k','Too cold!')
            viscosity = 0.00173;
            temp = 273;
            set(handles.water_temp,'string',num2str(temp));
        else
            set(handles.process_button,'enable','on')
            guidata(hObject,handles);
            return
        end
    else
        temp = round(str2double(get(handles.water_temp,'string')));
        viscosity = viscwater(temp-272,2);
    end
else
    viscosity = str2double(get(handles.other_viscosity,'string'));
end

%choose how much of it to analyse. Only convert what is needed
if get(handles.contiguous_analysis_button,'value') == 1
    %avitif(vid_path,'n',0,img_switches,img_params);
    
    %this must be sensitive to the kind of file being analysed...
    readpath = get(handles.pathbox,'string');
    if strcmp(readpath(end-2:end),'avi')
        obj = VideoReader(get(handles.pathbox,'string'));
        max_frames = obj.NumberOfFrames;
        mediatype = 'avi';
    elseif strcmp(readpath(end-2:end),'ids')
        while ~strcmp(readpath(end),'/')
            readpath = readpath(1:end-1);
        end
        currentdir = pwd;
        cd(readpath);
        filelist = dir('image*');
        max_frames = length(filelist)-1;
        cd(currentdir);
        mediatype = 'ids';
    end
else
    max_frames = str2double(get(handles.batch_size,'string'));
    %avitif(vid_path,'y',max_frames,img_switches,img_params);
end

% %denoise the images
% progressbar('De-noising video...');
% 
% for i = 1 : max_frames
%     img = imread(strcat('frame',num2str(i),'.tif'));
%     if get(handles.denoise_box,'value')
%         img = img - get(handles.background,'value');
%         img = img*(255/get(handles.background,'value'));
%     end
%     if get(handles.disc,'value')
%         radius = round(get(handles.background_disk,'value'));
%         se = strel('disk',radius);
%         img = imtophat(img,se);
%     end
%     if get(handles.blur_box,'value')
%         sigma = get(handles.blur,'value');
%         G = fspecial('gaussian',[round(sigma/2) round(sigma/2)],sigma);
%         img = imfilter(img,G,'same');
%     end
%     imwrite(img,strcat('frame',num2str(i),'.tif'));
%     progressbar(i/max_frames);
% end


%blur the images


%read analysis parameters from input boxes
minsteps = str2double(get(handles.minsteps_box,'string'));
sterr = str2double(get(handles.maxerr_box,'string'));
pxptch = str2double(get(handles.custom_pixel_box,'string'));
% if get(handles.contiguous_analysis_button,'value') == 0
%     frames = str2double(get(handles.batch_size,'string'));
% else
%     obj = VideoReader(get(handles.pathbox,'string'));
%     frames = obj.NumberOfFrames;
% end

frames = max_frames;

% start of the debug line to check the file extension 19/11/2026
if ~isfield(handles, 'mediatype')
    handles.mediatype = [];
    guidata(hObject, handles);
end
%mediatype = handles.mediatype;

fprintf('mediatype = %s\n', mediatype)
% end of the debug line to check the file extension 19/11/2026
%set video framerate
if strcmp(mediatype,'avi')
    path = get(handles.pathbox,'string');
    obj = VideoReader(path);
    framerate = obj.FrameRate;
elseif strcmp(mediatype,'ids')
    %framerate = str2double(get(handles.pathbox,'string'));
    path = get(handles.pathbox,'string');
    %fclose all; %please work!

    try %try opening the new data file
        newpath = strcat(path(1:end-10),'capturedata.mtlb');
        newfile = fopen(newpath,'r');
        frameratecell = textscan(newfile,'%f%1c',1);
        framerate = frameratecell{1};
        fclose(newfile);
        delete(newpath);
        newfile2 = fopen(newpath,'w');
        fprintf(newfile2,'%f',framerate);
        fprintf(newfile2,'%s',';');
        fclose(newfile2);
    catch %if it doesn't exist, then read the old one and make a new one!
        newpath = strcat(path(1:end-10),'capturedata.mtlb');
        fid = fopen(strcat(path(1:end-10),'capturedata.mdf'),'r');
        framerate = fscanf(fid,'%f');
        fclose(fid);
        newfile = fopen(newpath,'w');
        for iteration = 1 : 1000
            fprintf(newfile,'%f',framerate);
            fprintf(newfile,'%s',';');
        end
        fclose(newfile);
    end
    
else
    errordlg('Something went wrong when reading the framerate - no datatype was successfully set');
    return
end
%errordlg(strcat('framerate is',num2str(framerate)));
%get detection parameters
detection_params = zeros(3,1);
detection_params(1) = get(handles.glob_slide,'value');
detection_params(2) = get(handles.cutoff_slide,'value');
detection_params(3) = get(handles.thresh_slide,'value');

%get the step length
step_length = round(get(handles.step_length_slide,'value'));

%do the time-consuming donkeywork
[first_matrix] = input_transformer(path,1,frames,50,img_switches,img_params,detection_params,step_length);
csvwrite('first_matrix.csv',first_matrix);

%fix the frame numbers in the second column
first_matrix = columnfixer(first_matrix);
csvwrite('first_matrix_fixed.csv',first_matrix);

%columns 3 and 4 of 'first matrix' are then the x and y co-ordinates of
%each particle, the particle ID numbers are contained in column 1. This
%needs to have an optional drift correction applied to it. Column 5 should
%be the intensity.

%test it
%disp(first_matrix);

drifty = [];
driftx = [];
if get(handles.drift,'value');
   %apply drift correction...
   %Work out how many frames
   number_of_frames = max(first_matrix(:,2));
   disp('number of frames');
   disp(number_of_frames);
   row_index = 1;
   avpos = zeros(number_of_frames,2);
   particle_index = 0;
   xcounter = 0;
   ycounter = 0;
   
   %try writing this again...
   max_frames = max(first_matrix(:,2));
   rows = length(first_matrix(:,1));
   framepos = {};
   framepos{max_frames} = [];
   for current_frame = 1 : max_frames
       for current_row = 1 : rows
           if first_matrix(current_row,2) == current_frame
               framepos{current_frame} = [framepos{current_frame}; first_matrix(current_row,3) first_matrix(current_row,4)];
               %framepos now holds each of the particles, sorted by frame.
               %Each frame may now be averaged to obtain a sensible
               %average.
           end
       end
   end
   avpos = zeros(max_frames,2);
   for current_frame = 1 : max_frames
       if ~isempty(framepos{current_frame})
           avpos(current_frame,1) = mean(framepos{current_frame}(:,1));
           avpos(current_frame,2) = mean(framepos{current_frame}(:,2));
       else
           avpos(current_frame,1) = 640;
           avpos(current_frame,2) = 512;
       end
   end
   
%    This next commented block is probably incorrect.
   
   
%    for current_frame = 1 : number_of_frames
% %        disp(first_matrix);
% %        disp(row_index);
%        while first_matrix(row_index,2) == current_frame
%            xcounter = xcounter + first_matrix(row_index,3);
%            ycounter = ycounter + first_matrix(row_index,4);
%            particle_index = particle_index + 1;
%            row_index = row_index + 1;
%        end
%        avpos(current_frame,1) = xcounter/particle_index;
%        avpos(current_frame,2) = ycounter/particle_index;
%        %disp('particle_index');
%        %disp(particle_index);
%        ycounter = 0;
%        xcounter = 0;
%        particle_index = 0;
%        %disp('avpos');
%        %disp(avpos);
%    end
   %now avpos contains the average particle positions in each frame of
   %video.
   
   %the next step is to calculate the mean drift between each pair of
   %frames.
   mean_drift = zeros(length(avpos(:,1))-1,2);
   for transition = 1 : length(mean_drift)
       mean_drift(transition,1) = avpos(transition + 1,1) - avpos(transition,1);
       mean_drift(transition,2) = avpos(transition + 1,2) - avpos(transition,2);
   end
   %mean_drift now contains the mean x and mean y drift between each pair
   %of frames. In most cases, the x drift can be ignored, since the
   %troublesome convection should only be affecting the drift in the y
   %direction.
   
   %disp(mean_drift);
   
   %these numbers now need to be put into driftx and drifty for passing to
   %later functions...
   drifty = zeros(length(mean_drift(:,1)),1);
   driftx = drifty;
   for i = 1 : length(mean_drift(:,1))
       driftx(i) = mean_drift(i,1);
       drifty(i) = mean_drift(i,2);
   end
   
   %account for preferences in single-direction correction...
   if ~get(handles.xcorrect,'value')
       driftx = [];
   end
   if ~get(handles.ycorrect,'value')
       drifty = [];
   end
   
   
   %there is probably an easier means of accomplishing this, as it means
   %that if 'use drift correction' is selected, it adds significant
   %computational time to the analysis, even if neither of the directions
   %are selected to no drift correction actually takes place. This may be
   %accounted for at a later date...
end




%raw_matrix = accuracy(first_matrix,minsteps,sterr,framerate);

%'accuracy' and all subroutines therein are now part of a new function called
%'compound'. This makes debugging more elegant, and also allows for dynamic
%changes to be made in the track lengths to correct for drift of particles.

%if both driftx and drifty are empty arrays, then no drift correction will occur.
raw_matrix = compound(first_matrix,framerate,minsteps,sterr,driftx,drifty); %5th column is intensity
disp(framerate);
%test it
%disp(raw_matrix);
fidtest = fopen('raw_matrix.file','w');
fprintf(fidtest,'%f',raw_matrix);
fclose(fidtest);

size_matrix = sizecor(raw_matrix,pxptch);
csvwrite('first_matrix.csv',first_matrix);
csvwrite('raw_matrix.csv',raw_matrix);
csvwrite('size_matrix.csv',size_matrix);


%and splurge the two matrices together, replacing arbitrary path lengths
%with pixel-size corrected values
full_matrix = zeros(length(size_matrix(:,1)),4);%4th column for intensity
for i = 1 : length(size_matrix(:,1))
    full_matrix(i,1) = size_matrix(i,1);
    full_matrix(i,2) = size_matrix(i,2);
    full_matrix(i,3) = raw_matrix(i,3);
    full_matrix(i,4) = raw_matrix(i,5);
end

%just_matrix=full_matrix;
%csvwrite('just_matrix.csv',just_matrix);


%replace pixel-corrected values with corresponding radii
for z = 1 : length(full_matrix(:,1))
    temporary = full_matrix(z,1);
    full_matrix(z,1) = stokes_einstein(temp,full_matrix(z,1),viscosity);%this needs fixing for nanometers, not meters.
    full_matrix(z,2) = (full_matrix(z,2)/temporary)*full_matrix(z,1);
end

%strip out particles smaller than minimum expected
min_size = str2double(get(handles.min_particle_size,'string'));
len = length(full_matrix); %makes things easier later
for t = 1 : length(full_matrix)-1
    if full_matrix(len-t+1,1)<(min_size/(10^9)) %make it nanometres
        full_matrix(len-t+1,:) = [];
    end
end

csvwrite('full_matrix.csv',full_matrix);

fidtest = fopen('full_matrix.file','w');
fprintf(fidtest,'%f',full_matrix);
fclose(fidtest);

%test it...
%disp(full_matrix);
csvwrite('full_matrix.csv',full_matrix);

%write output data to csv file
[filename,pathname,filter] = uiputfile('.csv');
% fileID = fopen(strcat(pathname,filename),'wt');
% for p = 1 : length(full_matrix(:,1))
%     fprintf(fileID,'\n%d,%d,%d,%d',full_matrix(p,:));
% end
% fclose(fileID);
csvwrite(strcat(pathname,filename),full_matrix);
%this leaves an output of columns size, standard error, and track length

%and set this path to be the default .csv file location for the output
%section
set(handles.output_path,'string',strcat(pathname,filename));

%delete video files from scratch directory
% for q = 1 : frames
%     delete(strcat('frame',num2str(q),'.tif'));
% end

%and do an automatic plot of the output data in the output window
histogram_auto = autohist(full_matrix(:,1));
bar(handles.output_histogram,histogram_auto(:,1),histogram_auto(:,2));
set(handles.process_button,'enable','on')

%set the high-pass in the output section to 
set(handles.bottom_trim_box,'string',get(handles.min_particle_size,'string'));

%calculate the mean size
mean_size = mean(size_matrix(:,1));

%and display it
set(handles.mean_size,'string',strcat('Mean size is: ',num2str(round(mean_size)),'nm'));

%get the refractive index
m = str2double(get(handles.refractive,'string'));

%pass first_matrix to something that sorts out the particle eccentricity
%data
%shp = get(handles.shape,'value')
if get(handles.shape,'value')
    %set (handles.text40,'String',shp);
    shape = real(eccentricity(first_matrix,m,mean_size));%mean_size is the mean size is ensemble = 0, array otherwise. Ensemble is 0 for yes, 1 for no
   
    %display the calculated shape
    shape_string = 'Shape parameters a and b are:';
if shape(1,1) ~= 0
    shape_string = strcat(shape_string,' ',num2str(shape(1,1)),', ',num2str(shape(1,2)));
end
if shape(2,1) ~= 0
    shape_string = strcat(shape_string,'; ',num2str(shape(2,1)),', ',num2str(shape(2,2)));
end
if shape(3,1) ~= 0
    shape_string = strcat(shape_string,'; ',num2str(shape(3,1)),', ',num2str(shape(3,2)));
end
if shape(4,1) ~= 0
    shape_string = strcat(shape_string,'; ',num2str(shape(4,1)),', ',num2str(shape(4,2)));
end
if strcmp('Shape parameters a and b are:',shape_string)
    shape_string = 'There was an unexpected error calculating the shape.';
end
set(handles.shape_is,'string',shape_string);
end

 





%remove this file...
try
    %delete('framerate.nanodata');
catch
end

guidata(hObject,handles);



