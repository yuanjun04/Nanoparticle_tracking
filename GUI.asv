% eventdata  structure with the following fields (see UIBUTTONGROUP)
%	EventName: string 'SelectionChanged' (read only)
%	OldValue: handle of the previously selected object or empty if none was selected
%	NewValue: handle of the currently selected object
% handles    structure with handles and user data (see GUIDATA)

%get value of save path.
savepath = get(handles.savepath,'string');

%get current analysis file path
analysispath = get(handles.pathbox,'string');

%and decide what to do based on other GUI elements - I have no idea how to
%use knowledge of what type of event this is...
if strcmp('Enter path here',analysispath) == 1
    set(handles.pathbox,'string',savepath);
elseif strcmp(savepath,'Enter save path here')
    errordlg('You cannot use the most recently captured data until some data has been captured!','Error!');
elseif strcmp(savepath,analysispath) == 1
    set(handles.pathbox,'string','Enter path here');
else
    set(handles.pathbox,'string',savepath);
end
    

guidata(hObject,handles);


