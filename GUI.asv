if ispc && isequal(get(hObject,'BackgroundColor'), get(0,'defaultUicontrolBackgroundColor'))
    set(hObject,'BackgroundColor','white');
end


% --- Executes on button press in plot_replot.
function plot_replot_Callback(hObject, eventdata, handles)
% hObject    handle to plot_replot (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%This gets annoying when files don't exist...
%set(handles.plot_replot,'enable','off');

datafile = get(handles.output_path,'string');
data = csvread(datafile);

%make sure that any lines of spreadsheet with NaN or inf are removed.
data = remove_invalid(data);

% %trim the data as required
top_trim = get(handles.top_trim_checkbox,'value');
if top_trim
    max_allowed = str2double(get(handles.top_trim_box,'string'))/(10^9);
    if max_allowed == 0
        errordlg('please specify an upper particle size limit!','Trimming error!');
    end
   len = length(data(:,1));
    for i = 1 : len
        if data(len-i+1,1) > max_allowed
            data(len-i+1,:) = [];
        end
    end
%     i = 1;
%     while i <= length(data(:,1))
%         if data(i,1) > max_allowed
%             data(i,:) = [];
%             i = i-1;
%         end
%         i = i+1;
%     end
end

bottom_trim = get(handles.bottom_trim_checkbox,'value');
if bottom_trim
    min_allowed = str2double(get(handles.bottom_trim_box,'string'))/(10^9);
    if min_allowed == 0
        errordlg('please specify a lower particle size limit!','Trimming error!');
    end
    len = length(data(:,1));
    for i = 1 : len
        if data(len-i+1,1) < min_allowed
            data(len-i+1,:) = [];
        end
    end
end

%control for minimum track length
minsteps = str2double(get(handles.minsteps2,'string'));
len = length(data(:,1));
for i = 1 : len
    if data(len-i+1,3) < minsteps
        data(len-i+1,:) = [];
    end
end

%get plot type (straight histogram or guassian-weighted curve)
plot_type = get(handles.dist_smooth,'value');

%basic histogram plot
if plot_type == 0
    %calculate histogram binning
    if get(handles.auto_hist_bin,'value') == 0
        nbins = str2double(get(handles.cust_hist_bin_val,'string'));
        if nbins == 0 %make sure a value has been entered
            errordlg('You need to select a number of bins','Histogram Error!');
            set(handles.plot_replot,'enable','on');
            guidata(hObject,handles);
            return
        end
        [nelements,centres] = hist(data(:,1),nbins);
        plot_data = zeros(length(nelements),2);
        plot_data(:,1) = centres;
        plot_data(:,2) = nelements;
    else
        plot_data = autohist(data(:,1));
    end
end

%nice smoothed-out guassian plot, 1nm bins
if plot_type == 1
    plot_data = gaussian_plot(data);    
end

%check plot data is sensible
if length(plot_data(:,1)) < 3
    errordlg('For some reason, your plotting settings are incompatible with your current data. Please choose different settings and replot.','Histogram Error!');
    set(handles.plot_replot,'enable','on');
    guidata(hObject,handles);
    return
end

%plot it
if plot_type == 0
    bar(handles.output_histogram,plot_data(:,1),plot_data(:,2));
end

%plot smoothed gaussian version.
if plot_type == 1
    if get(handles.top_trim_checkbox,'value')
        plot_max = str2double(get(handles.top_trim_box,'string'));
        if plot_max < length(plot_data(:,1))
            for i = plot_max : length(plot_data(:,1))-1
                plot_data(plot_max+1,:) = [];
            end
        end
    end
    if get(handles.bottom_trim_checkbox,'value')
        plot_min = str2double(get(handles.bottom_trim_box,'string'));
        for i = 1 : plot_min
            plot_data(1,:) = [];
        end
    end
    plot(handles.output_histogram,plot_data(:,1),plot_data(:,2));
end



%decide whether to look for peaks
if str2double(get(handles.peak_count,'string')) ~= 0
    %check that there's sufficient data to find this many peaks
    if str2double(get(handles.cust_hist_bin_val,'string')) ~= 0
        if str2double(get(handles.peak_count,'string')) >= str2double(get(handles.cust_hist_bin_val,'string'))
            if get(handles.cust_hist_bin,'value')
                errordlg('You are looking for too many peaks!','Peak finding error!')
                set(handles.plot_replot,'enable','on');
                guidata(hObject,handles);
                return
            end
        end
    end
    if str2double(get(handles.peak_count,'string')) >= length(data(:,1))/10
        errordlg('You are looking for too many peaks!','Peak finding error!')
        set(handles.plot_replot,'enable','on');
        guidata(hObject,handles);
        return
    end
    peaks = zeros(str2double(get(handles.peak_count,'string')),2); %2 columns, location and height
    peaks = pkfind(plot_data,peaks,str2double(get(handles.peak_count,'string')));
    %add first particle
    set(handles.peaks_detected,'string',strcat(num2str(round(peaks(1,1)*10^9)),' nm, ',num2str(peaks(1,2)),' particles'));
    %and the rest if necessary
    string = {strcat(num2str(round(peaks(1,1)*(10^9))),' nm, ',num2str(peaks(1,2)),' particles')};
    if str2double(get(handles.peak_count,'string')) > 1
        for peak = 2 : str2double(get(handles.peak_count,'string'))
            %write the output
            string{end+1} = strcat(num2str(round(peaks(peak,1)*(10^9))),' nm, ',num2str(peaks(peak,2)),' particles');
            set(handles.peaks_detected,'string',string);
        end
    end
else
   set(handles.peaks_detected,'string','Choose a number of peaks to find!');
end

%add something to calculate the mean size within the selected range and
%standard deviation/standard error.
if ~plot_type %for bar chart
    %stats for bar histogram
    %first column of plot_data is size, second is count...
    
    %mean first
    output_sum = 0;
    for bin = 1 : length(plot_data(:,1))
        output_sum = output_sum + (plot_data(bin,1)*plot_data(bin,2)); %sum all bins
    end
    output_mean = output_sum/sum(plot_data(:,2)); %divide by datapoints
    set(handles.mean_size,'string',strcat('Mean size is: ',num2str(round(output_mean*(10^9),2)),'nm')); %and display it
    
    %then stdev
    set(handles.stdev,'string',strcat('Standard deviation is: ',num2str(round(std(plot_data(:,1),plot_data(:,2))*(10^9),2)),'nm'));
    
    %then sterr
    stdev = std(plot_data(:,1),plot_data(:,2));
    sterr = stdev/(sqrt(sum(plot_data(:,2))));
    set(handles.sterr,'string',strcat('Standard error is: ',num2str(round(sterr*(10^9),2)),'nm'));
    
    %particle count is easy!
    set(handles.partnum,'string',strcat('Particle count is: ',num2str(sum(plot_data(:,2)))));
    
elseif plot_type %for smoothed gaussian
    %stats for gaussian
    %first column of plot_data is size, second is count...
    
    %mean first
    output_sum = 0;
    for bin = 1 : length(plot_data(:,1))
        output_sum = output_sum + (plot_data(bin,1)*plot_data(bin,2)); %sum all bins
    end
    output_mean = output_sum/length(plot_data(:,1)); %divide by datapoints
    set(handles.mean_size,'string',strcat('Mean size is: ',num2str(round(output_mean*(10^9),2)),'nm')); %and display it
    
    %then stdev
    set(handles.stdev,'string',strcat('Standard deviation is: ',num2str(round(std(plot_data(:,1),plot_data(:,2))*(10^9),2)),'nm'));
    
    %then sterr
    stdev = std(plot_data(:,1),plot_data(:,2));
    sterr = stdev/(sqrt(sum(plot_data(:,2))));
    set(handles.sterr,'string',strcat('Standard error is: ',num2str(round(sterr*(10^9),2)),'nm')); %which is wrong as it incorrectly accounts for the number of particles.
    
    %particle count is easy!
    set(handles.partnum,'string',strcat('Particle count is: ',num2str(sum(plot_data(:,2))))); %this is actually wrong, it gives the number of datapoints used in the smoothed distribution!
else
    errordlg('Something is wrong with the universe - this shouldn''t be accessible code if 1~=0');
end

set(handles.plot_replot,'enable','on');

%update handles structure
guidata(hObject,handles);


