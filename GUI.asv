function screen_gain_num_Callback(hObject, eventdata, handles)
% hObject    handle to screen_gain_num (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Hints: get(hObject,'String') returns contents of screen_gain_num as text
%        str2double(get(hObject,'String')) returns contents of screen_gain_num as a double
set(handles.screen_gain_slide,'value',str2double(get(handles.screen_gain_num,'string')));

img = image_cleanup(hObject,handles);
%display it
axes(handles.camera_preview);
imshow(img);

hold on

preview_spots = check_detection(hObject,handles);
scatter(preview_spots(:,1),preview_spots(:,2));

hold off

%update the handles structure
guidata(hObject,handles);



% --- Executes during object creation, after setting all properties.
function screen_gain_num_CreateFcn(hObject, eventdata, handles)
% hObject    handle to screen_gain_num (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    empty - handles not created until after all CreateFcns called

% Hint: edit controls usually have a white background on Windows.
%       See ISPC and COMPUTER.
if ispc && isequal(get(hObject,'BackgroundColor'), get(0,'defaultUicontrolBackgroundColor'))
    set(hObject,'BackgroundColor','white');
end


% --- Executes on button press in expconf.
function expconf_Callback(hObject, eventdata, handles)
% hObject    handle to expconf (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

disc_on = num2str(get(handles.disc,'value'));
disc_val = num2str(get(handles.background_disk,'value'));
compress_on = num2str(get(handles.denoise_box,'value'));
compress_val = num2str(get(handles.background,'value'));
blur_on = num2str(get(handles.blur_box,'value'));
blur_val = num2str(get(handles.blur,'value'));
gain_on = num2str(get(handles.screen_gain_box,'value'));
gain_val = num2str(get(handles.screen_gain_slide,'value'));
gsp_val = num2str(get(handles.glob_slide,'value'));
cutoff_val = num2str(get(handles.cutoff_slide,'value'));
threshold_val = num2str(get(handles.thresh_slide,'value'));
minsteps_val = get(handles.minsteps_box,'string');
maxerr_val = get(handles.maxerr_box,'string');
%set contiguous analysis!
pix_val = get(handles.custom_pixel_box,'string');
%set temperature!
minsize_val = get(handles.min_particle_size,'string');
maxjump_val = num2str(get(handles.step_length_slide,'value'));
%use drift correction always!

fid = fopen('analysis_settings.conf','w');
fprintf(fid,strcat(disc_on,'\n'));
fprintf(fid,strcat(disc_val,'\n'));
fprintf(fid,strcat(compress_on,'\n'));
fprintf(fid,strcat(compress_val,'\n'));
fprintf(fid,strcat(blur_on,'\n'));
fprintf(fid,strcat(blur_val,'\n'));
fprintf(fid,strcat(gain_on,'\n'));
fprintf(fid,strcat(gain_val,'\n'));
fprintf(fid,strcat(gsp_val,'\n'));
fprintf(fid,strcat(cutoff_val,'\n'));
fprintf(fid,strcat(threshold_val,'\n'));
fprintf(fid,strcat(minsteps_val,'\n'));
fprintf(fid,strcat(maxerr_val,'\n'));
fprintf(fid,strcat(pix_val,'\n'));
fprintf(fid,strcat(minsize_val,'\n'));
fprintf(fid,strcat(maxjump_val,'\n'));
fclose(fid);


% --- Executes on button press in export_graph.
function export_graph_Callback(hObject, eventdata, handles)
% hObject    handle to export_graph (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)


datafile = get(handles.output_path,'string');
data = csvread(datafile);

%make sure that any lines of spreadsheet with NaN or inf are removed.
data = remove_invalid(data);


% %trim the data as required
top_trim = get(handles.top_trim_checkbox,'value');
if top_trim
    max_allowed = str2double(get(handles.top_trim_box,'string'))/(10^9);
    if max_allowed == 0
        errordlg('please specify an upper particle size limit!','Trimming error!');
    end
   len = length(data(:,1));
    for i = 1 : len
        if data(len-i+1,1) > max_allowed
            data(len-i+1,:) = [];
        end
    end
%     i = 1;
%     while i <= length(data(:,1))
%         if data(i,1) > max_allowed
%             data(i,:) = [];
%             i = i-1;
%         end
%         i = i+1;
%     end
end

bottom_trim = get(handles.bottom_trim_checkbox,'value');
if bottom_trim
    min_allowed = str2double(get(handles.bottom_trim_box,'string'))/(10^9);
    if min_allowed == 0
        errordlg('please specify a lower particle size limit!','Trimming error!');
    end
    len = length(data(:,1));
    for i = 1 : len
        if data(len-i+1,1) < min_allowed
            data(len-i+1,:) = [];
        end
    end
end

%control for minimum track length
minsteps = str2double(get(handles.minsteps2,'string'));
len = length(data(:,1));
for i = 1 : len
    if data(len-i+1,3) < minsteps
        data(len-i+1,:) = [];
    end
end

plot_data = gaussian_plot(data);  



%check plot data is sensible
if length(plot_data(:,1)) < 3
    errordlg('For some reason, your plotting settings are incompatible with your current data. Please choose different settings and replot.','Histogram Error!');
    set(handles.plot_replot,'enable','on');
    guidata(hObject,handles);
    return
end

if get(handles.top_trim_checkbox,'value')
    plot_max = str2double(get(handles.top_trim_box,'string'));
    if plot_max < length(plot_data(:,1))
        for i = plot_max : length(plot_data(:,1))-1
            plot_data(plot_max+1,:) = [];
        end
    end
end
if get(handles.bottom_trim_checkbox,'value')
    plot_min = str2double(get(handles.bottom_trim_box,'string'));
    for i = 1 : plot_min
        plot_data(1,:) = [];
    end
end


exportfile = strcat(datafile(1:end-3),'export.csv');
csvwrite(exportfile,plot_data);

%don't need to plot, need to export!
%plot(handles.output_histogram,plot_data(:,1),plot_data(:,2));


%decide whether to look for peaks
if str2double(get(handles.peak_count,'string')) ~= 0
    %check that there's sufficient data to find this many peaks
    if str2double(get(handles.cust_hist_bin_val,'string')) ~= 0
        if str2double(get(handles.peak_count,'string')) >= str2double(get(handles.cust_hist_bin_val,'string'))
            if get(handles.cust_hist_bin,'value')
                errordlg('You are looking for too many peaks!','Peak finding error!')
                set(handles.plot_replot,'enable','on');
                guidata(hObject,handles);
                return
            end
        end
    end
    if str2double(get(handles.peak_count,'string')) >= length(data(:,1))/10
        errordlg('You are looking for too many peaks!','Peak finding error!')
        set(handles.plot_replot,'enable','on');
        guidata(hObject,handles);
        return
    end
    peaks = zeros(str2double(get(handles.peak_count,'string')),2); %2 columns, location and height
    peaks = pkfind(plot_data,peaks,str2double(get(handles.peak_count,'string')));
    %add first particle
    set(handles.peaks_detected,'string',strcat(num2str(round(peaks(1,1)*10^9)),' nm, ',num2str(peaks(1,2)),' particles'));
    %and the rest if necessary
    string = {strcat(num2str(round(peaks(1,1)*(10^9))),' nm, ',num2str(peaks(1,2)),' particles')};
    if str2double(get(handles.peak_count,'string')) > 1
        for peak = 2 : str2double(get(handles.peak_count,'string'))
            %write the output
            string{end+1} = strcat(num2str(round(peaks(peak,1)*(10^9))),' nm, ',num2str(peaks(peak,2)),' particles');
            set(handles.peaks_detected,'string',string);
        end
    end
else
   set(handles.peaks_detected,'string','Choose a number of peaks to find!');
end

%update handles structure
guidata(hObject,handles);


