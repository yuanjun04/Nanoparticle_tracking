% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Hints: get(hObject,'String') returns contents of glob_num as text
%        str2double(get(hObject,'String')) returns contents of glob_num as a double


%set the slider to the same value  as the box
%set slider to box value
max = get(handles.glob_slide,'max');
min = get(handles.glob_slide,'min');
val = str2double(get(handles.glob_num,'string'));
if val>max
    val = max;
    set(handles.glob_num,'string',num2str(val));
elseif val<min
    val = min;
    set(handles.glob_num,'string',num2str(val));
end
set(handles.glob_slide,'value',val);


img = image_cleanup(hObject,handles);

%display it
axes(handles.camera_preview);
imshow(img);
hold on

preview_spots = check_detection(hObject,handles);
scatter(preview_spots(:,1),preview_spots(:,2));

hold off



guidata(hObject,handles);



