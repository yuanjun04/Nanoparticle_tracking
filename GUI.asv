% --- Executes on button press in restore.
function restore_Callback(hObject, eventdata, handles)
% hObject    handle to restore (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)


%set disc info
fid = fopen('discsw.file','r');
if fread(fid)
    set(handles.disc,'value',1);
    fid2 = fopen('discval.file','r');
    set(handles.background_disk,'value',fread(fid2));
    fclose(fid2);
else
    set(handles.disc,'value',0);
end
fclose(fid);

%set compress info
fid = fopen('compressse.file','r');
if fread(fid)
    set(handles.denoise_box,'value',1);
    fid2 = fopen('compressval.file','r');
    set(handles.background,'value',fread(fid2));
    flcose(fid2);
else
    set(handles.denoise_box,'value',0);
end
fclose(fid);

%blur
fid = fopen('blurse.file','r');
if fread(fid)
    set(handles.blur_box,'value',1);
    fid2 = fopen('blurval.file','r');
    set(handles.blur,'value',fread(fid2));
    fclose(fid2);
else
    set(handles.blur_box,'value',0);
end
fclose(fid);

%glob
fid = fopen('globval.file','r');
set(handles.glob_slide,'value',fread(fid));
fclose(fid);

%cutoff
fid = fopen('cutoffval.file','r');
set(handles.cutoff_slide,'value',fread(fid));
fclose(fid);

%pth
fid = fopen('pthval.file','r');
set(handles.thresh_slide,'value',fread(fid));
fclose(fid);

%file
fid = fopen('file.file','r');
set(handles.pathbox,'string',fread(fid));
fclose(fid);

%scrub max
fid = fopen('scrubbermax.file','r');
set(handles.position,'max',fread(fid));
fclose(fid);

%scrub
fid = fopen('scrubber.file','r');
set(handles.position,'value',fread(fid));
fclose(fid);

guidata(hObject,handles);


