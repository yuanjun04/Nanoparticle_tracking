% --- Executes on button press in select_file.
function select_file_Callback(hObject, eventdata, handles)
% hObject    handle to select_file (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)





[filename,filepathname,filter] = uigetfile({'*.avi;*.ids','Readable video files'});
set(handles.pathbox,'string',strcat(filepathname,filename));
try
    path = str2double(get(handles.pathbox,'string'));
    if path == 0
        set(handles.pathbox,'string','Enter path here (please)');
    else
        set(handles.popoutanal,'visible','on');
    end
catch
end

%work out whether it's an .avi video or an .ids datafile
datafile = get(handles.pathbox,'string');
if strcmp(datafile(end),'i') %this is a fragile way to detect avi extension
    % define mediatype explicitly for use in processing 19/11/2026
    set(handles.pathbox,'string',strcat(filepathname,filename));
    % end of 19/11/2026 correction
    %read video file
    obj = VideoReader(get(handles.pathbox,'string'));
    vid = read(obj,1);

    %set parameters on stepthrough slider
    set(handles.position,'value',1);
    set(handles.position,'min',1);
    set(handles.position,'max',obj.NumberOfFrames);


    %set parameters on blur slider
    set(handles.blur,'value',1);
    set(handles.blur,'min',1);
    set(handles.blur,'max',20);

% frames = obj.NumberOfFrames;
% set(handles.position,'max',frames);
% set(handles.position,'min',1);

    img = image_cleanup(hObject,handles);

    %generate initial preview
    axes(handles.camera_preview);
    %imshow(vid(:,:,:,1),[]);
    imshow(img);
else
    %get the directory the files are stored in
    newdir = datafile;
    while ~strcmp(newdir(end),'/')
        newdir = newdir(1:end-1);
    end
    
    %open the first image
    %img = imread(strcat(newdir,'image0.tif'));
    
    %work out how many images
    workingdir = pwd;
    cd(newdir);
    filelist = dir('image*');
    cd(workingdir);
    framecount = length(filelist)-1;
    
    %make a cell array linking the frame numbers to the filenames
%     framenumber = 1 : framecount;
%     frameindex{1} = framenumber;
%     frameindex{2} = [];
%     filenumber = 0 : framecount-1;
%     for k = 1 : framecount
%         frameindex{2}(end+1) = strcat('image',num2str(filenumber(k)),'.tif');
%     end
    
    %set parameters on stepthrough slider
    set(handles.position,'value',1);
    set(handles.position,'min',1);
    set(handles.position,'max',framecount);


    %set parameters on blur slider
    set(handles.blur,'value',1);
    set(handles.blur,'min',1);
    set(handles.blur,'max',20);
    
    img = image_cleanup(hObject,handles);
    axes(handles.camera_preview);
    imshow(img);
end

set(handles.popout_anal,'visible','on');

guidata(hObject,handles);



