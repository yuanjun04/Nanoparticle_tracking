% --- Executes on button press in snapshot.
function snapshot_Callback(hObject, eventdata, handles)
% hObject    handle to snapshot (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%make sure that live mode is disabled.
if str2double(get(handles.livetime,'string')) == 1
    set(handles.livetime,'string','0');
    %and ensure that the last capture process has had time to exit
    pause(0.5)
end

%get savepath for video
savepath = get(handles.savepath,'string');

%check that a savepath has been selected
if strcmp(savepath,'Enter save path here')
    errordlg('Please select a filename','Filename error!');
    return;
end

%remove avi extension and replace it with tif for uncompressed image.
savepath = strcat(savepath(1:end-4),'0.tif');

%check if there's an image file with that name already there. If there is,
%start a numbering convention. For very large numbers, this can get quite
%slow, but it avoids overwriting if the program is restarted and then
%captures more snapshots with the same filestub.
a = 0;
b = 0;
while a == 0
    try
        imread(strcat(savepath(1:end-5),num2str(b),'.tif'));
    catch
        savepath = strcat(savepath(1:end-5),num2str(b),'.tif');
        a = 1;
    end
    b = b + 1;
end


%get capture pearameters from GUI
gain_boost = get(handles.gainboost,'value');
gain_val = round(get(handles.gain_slider,'value'));
exposure_val = exposures();
old_exposure = get(handles.exposure,'Value');
if and(old_exposure > exposure_val(1), old_exposure < exposure_val(2))
%     set(handles.exposure,'Min',exposure_val(1));
%     set(handles.exposure,'Max',exposure_val(2));
%     set(handles.exposure,'SliderStep',[exposure_val(3) exposure_val(3)]);
else
    set(handles.exposure,'Value',exposure_val(1));
%     set(handles.exposure,'Min',exposure_val(1));
%     set(handles.exposure,'Max',exposure_val(2));
%     set(handles.exposure,'SliderStep',[exposure_val(3) exposure_val(3)]);
end
exposure_new = get(handles.exposure,'value');

%get area of interest data
if get(handles.limit_roi_checkbox,'value')
    if strcmp('Left',get(handles.left_roi_limit,'string'))
        
        return
    else
        leftaoi = round(str2double(get(handles.left_roi_limit,'string')));
    end
    if strcmp('Right',get(handles.right_roi_limit,'string'))
        
        return
    else
        rightaoi = round(str2double(get(handles.right_roi_limit,'string')));
    end
    if strcmp('Top',get(handles.top_roi_limit,'string'))
        
        return
    else
        topaoi = round(str2double(get(handles.top_roi_limit,'string')));
    end
    if strcmp('Bottom',get(handles.bottom_roi_limit,'string'))
        
        return
    else
        bottomaoi = round(str2double(get(handles.bottom_roi_limit,'string')));
    end
    xstart = leftaoi;
    ystart = topaoi;
    width = abs(leftaoi-rightaoi);
    height = abs(topaoi-bottomaoi);
    %and validate the values to ensure they're compatible with the camera
    valid = validate_aoi(xstart,ystart,width,height);
    xstart = valid{1};
    ystart = valid{2};
    width = valid{3};
    height = valid{4};
    
else
    xstart = 1;
    ystart = 1;
    width = 0;
    height = 0;
end

%capture frame from camera
frame = get_snapshot(1,0,3,gain_boost,gain_val,exposure_new,xstart,ystart,width,height);

%select colour
if ~get(handles.colour_button,'value')
    frame = rgb2gray(frame);
end

imwrite(frame,savepath);

%re-enable capture button
set(handles.capture_button,'Enable','on');






guidata(hObject,handles);


