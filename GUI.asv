% --- Executes on button press in live.
function live_Callback(hObject, eventdata, handles)
% hObject    handle to live (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%this is very hacky. It exits with an error when an actual recording is
%started, as it's call on the camera gets shorted out.

%this doesn't let you change the capture settings during the looping
%either, it is purely for changing a hardware config (eg focus, sample
%position etc)

%allow the live view to be popped out...
set(handles.popout,'visible','on');

%get time to loop for
%open_camera();
running = 1;
set(handles.livetime,'string',num2str(1));  
%gain_boost = get(handles.gainboost,'value');    
%authenticate the exposure slider.
% exposure_val = exposures();
% old_exposure = get(handles.exposure,'Value');
% if and(old_exposure > exposure_val(1), old_exposure < exposure_val(2))
%     set(handles.exposure,'Min',exposure_val(1));
%     set(handles.exposure,'Max',exposure_val(2));
%     set(handles.exposure,'SliderStep',[exposure_val(3) exposure_val(3)]);
% else
%     set(handles.exposure,'Value',exposure_val(1));
%     set(handles.exposure,'Min',exposure_val(1));
%     set(handles.exposure,'Max',exposure_val(2));
%     set(handles.exposure,'SliderStep',[exposure_val(3) exposure_val(3)]);
% end
    
%make sure the exposure has been set
%exposure_new = get(handles.exposure,'value');
%set_new_exposure(exposure_new);

%gain_val = round(get(handles.gain_slider,'value'));
%pause on
% axes(handles.camera_preview);
while running
    running = str2double(get(handles.livetime,'string'));
    a = update_preview(hObject,eventdata,handles);
%     gain_boost = get(handles.gainboost,'value');
%     exposure_new = get(handles.exposure,'value');
%     gain_val = round(get(handles.gain_slider,'value'));
%     frame = get_still(1,0,3,gain_boost,gain_val,exposure_new);
%     running = str2double(get(handles.livetime,'string'));
%     %display it
%     
%     %select colour
%     colour_select = get(handles.colour_button,'value');
%     if colour_select == 0
%         frame = rgb2gray(frame);
%     end
%     axes(handles.camera_preview);
%     imshow(frame);
    guidata(hObject,handles);
    %pause(0.5);
end
    
set(handles.livetime,'string',num2str(0));    
    

guidata(hObject,handles);

