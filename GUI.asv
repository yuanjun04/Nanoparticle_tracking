% --- Executes on button press in drift.
function drift_Callback(hObject, eventdata, handles)
% hObject    handle to drift (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Hint: get(hObject,'Value') returns toggle state of drift

%enable and disable the x- and y-corrections as necessary.
if get(handles.drift,'value')
    set(handles.xcorrect,'enable','on');
    set(handles.ycorrect,'enable','on');
else
    set(handles.xcorrect,'enable','off');
    set(handles.ycorrect,'enable','off');
    set(handles.xcorrect,'value',0);
    set(handles.ycorrect,'value',0);
end


% --- Executes on button press in xcorrect.
function xcorrect_Callback(hObject, eventdata, handles)
% hObject    handle to xcorrect (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

% Hint: get(hObject,'Value') returns toggle state of xcorrect

%make sure that if neither correction has been selected, that no correction
%will be applied to save computational time
if ~get(handles.xcorrect,'value')
    if ~get(handles.ycorrect,'value')
        set(handles.drift,'value',0);
        set(handles.xcorrect,'enable','off');
        set(handles.ycorrect,'enable','off');
    end
end


