% --- Executes during object creation, after setting all properties.
function data_processing_panel_CreateFcn(hObject, eventdata, handles)
% hObject    handle to data_processing_panel (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    empty - handles not created until after all CreateFcns called

%set the recursion limit higher than the default 500 - some graphing calls
%appear ti use significantly higher than that, and hopefully any computer
%this is running on is sufficiently fast....

set(0,'RecursionLimit',3000);


% --- Executes on button press in gaussians_button.
function gaussians_button_Callback(hObject, eventdata, handles)
% hObject    handle to gaussians_button (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

%this button will go through the video file and drag out only particle
%locations, but without linking the trajectories. Then these data are
%written back into a new video file, which has the same name as the
%original, but this time with the addition of '_gauss' on the end. Where
%particles were detected, a normalised gaussian will be written.

%work out whether it's an avi or and ids file I'm trying to read...
readfile = get(handles.pathbox,'string');
if strcmp(readfile(end),'i')
    filetype = 'avi';
elseif strcmp(readfile(end),'s')
    filetype = 'ids';
else
    errordlg('Something went wring when determining the type of file to read.');
    return
end


%open the video file
if strcmp(filetype,'avi')
    obj = VideoReader(get(handles.pathbox,'string'));
end
    
%get video detection and denoise parameters
w = get(handles.glob_slide,'value');
cutoff = get(handles.cutoff_slide,'value');
pth = get(handles.thresh_slide,'value');

switches = zeros(3,1);
params = zeros(3,1);

switches(2) = get(handles.disc,'value');
switches(1) = get(handles.denoise_box,'value');
switches(3) = get(handles.blur_box,'value');

params(2) = get(handles.background_disk,'value');
params(1) = get(handles.background,'value');
params(3) = get(handles.blur,'value');

%get filename from pathbox
path = get(handles.gauss_path,'string');
if strcmp(path,'Enter save path here')
    errordlg('Please choose somewhere to save the file!','File save error!');
    return
end

%make a new blank video file
filename = path;
vid = VideoWriter(filename);
vid.FrameRate = obj.FrameRate;
vid.Quality = 100;
open(vid);

%set radius of gaussians to generate
radius = 20;

if strcmp(filetype,'avi')
    %iterate over frames of original video
    progressbar('Converting Video...');
    for i = 1 : obj.NumberOfFrames
        img = read(obj,i);    %read frame
        try
            img = rgb2gray(img);
        catch
            img = img;
        end
        img = imageprocess(img,switches,params); %denoise it
        output = detect_particles(img,round(w),cutoff,pth,[0 0],50); %find particles
        output = output{1};
        gaussimg = zeros(length(img(:,1))+(2*radius),length(img(1,:))+(2*radius));
        for j = 1 : length(output(:,1)) %loop over detected particles
            gaussimg = add_gaussian(gaussimg,radius,output(j,1),output(j,2),0,5);        
        end
        gaussimg = shrink_matrix(gaussimg,radius);
        %csvwrite('gauss_test.csv',gaussimg);
        const = max(gaussimg(:));
        writeVideo(vid,gaussimg*(1/const));
        progressbar(i/obj.NumberOfFrames);
    end
elseif strcmp(filetype,'ids')
    progressbar('Converting Video...');
    %figure out number of frames
    currentdir = pwd;
    newdir = readfile;
    while ~strcmp(newdir(end),'/')
        newdir = newdir(1:end-1);
    end
    cd(newdir);
    searchfile = dir('image*');
    cd(currentdir);
    framecount = length(searchfile);
    for i = 1 : framecount
        img = imread(strcat(newdir,'image',num2str(i),'.tif'));
        try
            img = rgb2gray(img);
        catch
            img = img;
        end
        img = imageprocess(img,switches,params); %denoise it
        output = detect_particles(img,round(w),cutoff,pth,[0 0],50); %find particles
        output = output{1};
        gaussimg = zeros(length(img(:,1))+(2*radius),length(img(1,:))+(2*radius));
        for j = 1 : length(output(:,1)) %loop over detected particles
            gaussimg = add_gaussian(gaussimg,radius,output(j,1),output(j,2),0,5);        
        end
        gaussimg = shrink_matrix(gaussimg,radius);
        %csvwrite('gauss_test.csv',gaussimg);
        const = max(gaussimg(:));
        writeVideo(vid,gaussimg*(1/const));
        progressbar(i/framecount);
    end
else
    errordlg('Something has gone badly wrong - it should be impossible to trigger this dialogue box...');
    return
end
        


